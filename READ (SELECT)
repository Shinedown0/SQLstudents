-- Question:
-- List all students with their course enrollments, if they have any.
-- Students without any course enrollment should also be displayed.

SELECT
   s.StudentID,
   s.StudentName,
   ce.CourseEnrollmentID,
   c.CourseName
FROM dbo.Students s
LEFT JOIN dbo.CourseEnrollments ce
   ON s.StudentID = ce.StudentID
LEFT JOIN dbo.Courses c
   ON ce.CourseID = c.CourseID;

-- Question:
-- List all teachers with the courses they teach, if they teach any.
-- Teachers without any assigned course should also be displayed.

SELECT
   t.TeacherID,
   t.TeacherName,
   c.CourseName
FROM dbo.Teachers t
LEFT JOIN dbo.Courses c
   ON t.TeacherID = c.TeacherID;

-- Question:
-- List all programs with their related courses, if they have any.
-- Programs without any related course should also be displayed.

SELECT
   p.ProgramID,
   p.ProgramName,
   c.CourseName
FROM dbo.Programs p
LEFT JOIN dbo.Courses c
   ON p.ProgramID = c.ProgramID;


