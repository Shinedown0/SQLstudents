-- Question:
-- Which students are enrolled in which courses?
-- Show all students, even if they are not enrolled in any course.

-- Answer
SELECT Students.StudentID, Students.StudentName, Courses.CourseName FROM Students 
LEFT JOIN CourseEnrollments ON Students.StudentID = CourseEnrollments.StudentID
LEFT JOIN Courses ON Courses.CourseID = CourseEnrollments.CourseID


-- Question:
-- Which students are enrolled in which courses?
-- Show just students has enrolled more than zero courses

SELECT Students.StudentID, Students.StudentName, Courses.CourseName FROM Students
INNER JOIN CourseEnrollments ON Students.StudentID = CourseEnrollments.StudentID
INNER JOIN Courses ON Courses.CourseID = CourseEnrollments.CourseID


SELECT Students.StudentID, Students.StudentName, Count(Students.StudentID)  FROM Students 
LEFT JOIN CourseEnrollments ON Students.StudentID = CourseEnrollments.StudentID
LEFT JOIN Courses ON Courses.CourseID = CourseEnrollments.CourseID
WHERE Courses.CourseID IS NOT NULL
GROUP BY Students.StudentID, Students.StudentName
HAVING COUNT(Students.StudentID) > 0


-- Question:
-- Which teachers teach which courses?
-- Show all teachers, even if they do not teach any course

SELECT * FROM Teachers 
LEFT JOIN Courses ON Courses.TeacherID = Teachers.TeacherID

-- Question:
-- Which teachers teach which students?
-- Show all teachers, even if they do not teach any students

SELECT Teachers.TeacherName, Students.StudentName  FROM Teachers 
LEFT JOIN Courses ON Courses.TeacherID = Teachers.TeacherID
LEFT JOIN CourseEnrollments ON Courses.CourseID = CourseEnrollments.CourseID
LEFT JOIN Students ON Students.StudentID = CourseEnrollments.StudentID


